wire [7:0] rMdDOut;
wire VCC;
wire GND;
  Gowin_PLL_MOD u_pll_0 (
    .clk_28m_d(clk_28m_d),
    .rRstOut(rRstOut),
    .clk_50m_d(clk_50m_d),
    .rMdInc(rMdInc),
    .rMdOpc(rMdOpc[1:0]),
    .rMdDOut(rMdDOut[7:0]),
    .pll_lock(pll_lock),
    .clk_200m(clk_200m),
    .wMdQOut(wMdQOut[7:0])
);
  PLL_INIT u_pll_init (
    .clk_50m_d(clk_50m_d),
    .pll_lock(pll_lock),
    .wMdQOut(wMdQOut[7:0]),
    .rMdInc(rMdInc),
    .rRstOut(rRstOut),
    .rMdOpc(rMdOpc[1:0]),
    .rMdDOut(rMdDOut[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL */
