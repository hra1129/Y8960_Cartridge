<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Y8960UpdWin</RootNamespace>
    <AssemblyName>Y8960UpdWin</AssemblyName>
    <AssemblyTitle>Y8960UPD for Windows</AssemblyTitle>
    <Product>Y8960UPD for Windows</Product>
    <Copyright>Copyright (C)2026 HRA!</Copyright>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UI language: Ja (default) or En. En renames the output to Y8960UpdWinEn.exe. -->
    <UiLanguage Condition="'$(UiLanguage)' == ''">Ja</UiLanguage>
    <AssemblyName Condition="'$(UiLanguage)' == 'En'">Y8960UpdWinEn</AssemblyName>
    <AssemblyTitle Condition="'$(UiLanguage)' == 'En'">Y8960UPD for Windows (English)</AssemblyTitle>
    <Product Condition="'$(UiLanguage)' == 'En'">Y8960UPD for Windows (English)</Product>
  </PropertyGroup>

  <!-- Compile exactly one UI text table, selected by UiLanguage. -->
  <ItemGroup>
    <Compile Remove="UiText.*.cs" />
    <Compile Include="UiText.$(UiLanguage).cs" />
  </ItemGroup>

</Project>
