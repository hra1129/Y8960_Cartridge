    .I2(cyccntr[1]),
    .I3(cyccntr[2]) 
);
defparam n13_s3.INIT=16'hFE01;
  LUT3 n14_s3 (
    .F(n14_9),
    .I0(ff_enable),
    .I1(cyccntr[0]),
    .I2(cyccntr[1]) 
