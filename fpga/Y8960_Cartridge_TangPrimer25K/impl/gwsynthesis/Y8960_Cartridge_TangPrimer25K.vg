  LUT2 n15_s4 (
    .F(n15_10),
    .I0(ff_enable),
    .I1(cyccntr[0]) 
);
defparam n15_s4.INIT=4'h9;
  DFFSE cntr_3_s0 (
    .Q(cyccntr[3]),
    .D(n12_6),
    .CLK(clk_28m_d),
    .SET(n319_7),
    .CE(cenop_30) 
);
  DFFSE cntr_2_s1 (
    .Q(cyccntr[2]),
    .D(n13_9),
    .CLK(clk_28m_d),
    .SET(n319_7),
    .CE(VCC) 
);
defparam cntr_2_s1.INIT=1'b1;
  DFFSE cntr_1_s1 (
    .Q(cyccntr[1]),
    .D(n14_9),
    .CLK(clk_28m_d),
    .SET(n319_7),
    .CE(VCC) 
